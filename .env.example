# API
PARKWISE_ENV=development
# Host/port used by scripts/run_local.sh (uvicorn); also the base URL written to web/.env.local
PARKWISE_API_HOST=0.0.0.0
PARKWISE_API_PORT=8000
PARKWISE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PARKWISE_DATABASE_URL=sqlite:///./data/parkwise.db
PARKWISE_DATA_DIR=./data
PARKWISE_MAX_UPLOAD_MB=250
PARKWISE_MAX_VIDEO_SECONDS=1800
PARKWISE_MODEL=yolo26s.pt
PARKWISE_CONFIDENCE=0.25
PARKWISE_IMAGE_SIZE=1280
PARKWISE_MULTISCALE=true
PARKWISE_FRAME_STRIDE=3
PARKWISE_DEVICE=auto
PARKWISE_AUTO_DOWNLOAD_PUBLIC_SOURCES=true

# Security (see docs/SECURITY.md; OWASP API Top 10 2023)
# true = every request needs an X-API-Key / Bearer token issued under Reports & Settings -> Users
PARKWISE_AUTH_REQUIRED=false
# Per-client budget for mutating requests; 0 disables the limiter
PARKWISE_RATE_LIMIT_PER_MINUTE=240

# Live view (annotated frame streaming over WebSocket)
PARKWISE_STREAM_WIDTH=960
PARKWISE_STREAM_QUALITY=72
# 0 = a live session runs until the client disconnects
PARKWISE_STREAM_MAX_SECONDS=0

# Frontend (read by the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
