# Public origin of the ParkWise API, as reached by the browser.
# Local development:  http://localhost:8000
# Vercel deployment:  https://your-api-host.example.com   (no trailing slash)
# This is a NEXT_PUBLIC_ variable — it is inlined at build time, so set it in
# the Vercel project settings (Settings → Environment Variables) *before* deploying.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
