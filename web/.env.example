# Public origin of the ParkWise API, as reached by the browser.
# Local development:  http://localhost:8000
# Deployed API:       https://your-api-host.example.com   (no trailing slash)
# This is a NEXT_PUBLIC_ variable — it is inlined at build time, so set it in
# the project environment settings *before* running `npm run build`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional extra origins to whitelist in the Content-Security-Policy (CSP)
# (e.g., custom S3/CDN media endpoints or self-hosted tile servers)
# NEXT_PUBLIC_EXTRA_CSP_ORIGINS=https://cdn.example.com,https://tiles.example.com
